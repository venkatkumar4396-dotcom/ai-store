# ==============================================
# NexusForge Backend - Environment Variables
# ==============================================

# Server Configuration
PORT=5000                          # Server port
NODE_ENV=development               # development | production
CORS_ORIGIN=http://localhost:3000  # Frontend URL for CORS

# Database (Prisma)
DATABASE_URL="file:./dev.db"       # SQLite for dev, PostgreSQL URL for production

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production    # Secret for signing JWTs
JWT_EXPIRES_IN=7d                  # Token expiration (e.g., 1h, 7d, 30d)

# Encryption (AES-256 for API key storage)
ENCRYPTION_KEY=your-32-character-encryption-key!!  # Must be exactly 32 characters

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-here            # Google Gemini API key

# Ollama (Local AI fallback)
OLLAMA_BASE_URL=http://localhost:11434              # Ollama server URL
OLLAMA_MODEL=llama3                                # Default Ollama model

# WhatsApp
WHATSAPP_SESSION_PATH=./data/whatsapp-sessions     # Path to store WhatsApp session data

# File Uploads
UPLOAD_DIR=./data/uploads          # Path for uploaded files
MAX_FILE_SIZE=10485760             # Max upload size in bytes (10MB)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000       # Rate limit window in ms (15 minutes)
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window

# Logging
LOG_LEVEL=info                     # error | warn | info | debug

# SMTP for OTP email delivery (optional — falls back to console log if not set)
SMTP_HOST=                         # e.g. smtp.gmail.com, smtp.sendgrid.net
SMTP_PORT=587                      # 587 for TLS, 465 for SSL
SMTP_USER=                         # SMTP username / email
SMTP_PASS=                         # SMTP password / app password
SMTP_FROM=noreply@nexora.ai        # "From" address for outgoing emails
