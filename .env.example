

# Backend Service Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL for Docker, SQLite for local dev)
POSTGRES_USER=nexusforge
POSTGRES_PASSWORD=nexusforge_secret_change_me
POSTGRES_DB=nexusforge
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption Key (Must be exactly 32 characters for AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Google OAuth Authentication (Optional — Google Mail authentication works out-of-the-box)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-here

# Clerk Auth (Optional — Free tier resource for user management)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here

# ─── Free AI LLM Configuration (Choose any or all) ───
# 1. Google Gemini (100% Free at https://aistudio.google.com/)
GEMINI_API_KEY=your-free-gemini-api-key-here

# 2. Groq (Ultra-fast 500+ tok/s free tier at https://console.groq.com/)
GROQ_API_KEY=your-free-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama (100% Free Local Offline LLM at https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 4. Optional Premium / Custom LLMs
KIMI_API_KEY=
META_API_KEY=

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:3000
