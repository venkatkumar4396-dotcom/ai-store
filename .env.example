# ==============================================
# NexusForge Root / Docker Environment Setup
# ==============================================

# Backend Service Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL for Docker, SQLite for local dev)
POSTGRES_USER=nexusforge
POSTGRES_PASSWORD=nexusforge_secret_change_me
POSTGRES_DB=nexusforge
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption Key (Must be exactly 32 characters for AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key!!

# AI API Keys
GEMINI_API_KEY=your-gemini-api-key-here
KIMI_API_KEY=your-moonshot-kimi-api-key-here

# Ollama Local LLM Integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:3000
